<%- include('partials/header', { title: 'PageAura | Home', currentPage: 'home' }) %>

<section class="hero">
  <div class="container hero-content">
    <div class="hero-text">
      <span class="eyebrow">WELCOME TO PAGEAURA</span>

      <h1>
        Discover your next
        <span>great read.</span>
      </h1>

      <p>
        Explore a carefully selected collection of books,
        discover new ideas, and find stories worth remembering.
      </p>

      <div class="hero-actions">
        <a href="/catalogue" class="btn btn-primary">
          Explore Books →
        </a>

        <% if (!user) { %>
          <a href="/register" class="btn btn-secondary">
            Create Account
          </a>
        <% } %>
      </div>
    </div>

    <div class="hero-card">
      <div class="book-stack">
        <div class="book book-one">
          <span>READ</span>
        </div>
        <div class="book book-two">
          <span>LEARN</span>
        </div>
        <div class="book book-three">
          <span>GROW</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">WHY PAGEAURA?</span>
      <h2>More than just a bookstore.</h2>
      <p>Everything you need to discover books you'll love.</p>
    </div>

    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">📚</div>
        <h3>Curated Collection</h3>
        <p>
          Browse a collection of popular and inspiring books
          across different categories.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🔎</div>
        <h3>Easy Discovery</h3>
        <p>
          Find books quickly with our simple catalogue and
          search functionality.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">✨</div>
        <h3>Simple Experience</h3>
        <p>
          Enjoy a clean, responsive and easy-to-use online
          bookstore experience.
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>