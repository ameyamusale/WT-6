<%- include("partials/header", { title: "Login" }) %>

<section class="auth-section">
  <div class="auth-card">
    <div class="auth-icon">🔐</div>
    <p class="eyebrow">WELCOME BACK</p>
    <h1>Login</h1>
    <p class="muted">Sign in to your BookNest account.</p>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <form method="POST" action="/login" class="form">
      <label>Email
        <input type="email" name="email" required placeholder="you@example.com">
      </label>
      <label>Password
        <input type="password" name="password" required placeholder="Enter password">
      </label>
      <button class="primary-btn full" type="submit">Login</button>
    </form>

    <p class="form-footer">Don't have an account? <a href="/register">Create one</a></p>
  </div>
</section>

<%- include("partials/footer") %>